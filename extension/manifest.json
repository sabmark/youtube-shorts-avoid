{
  "manifest_version": 3,
  "name": "YouTube Shorts Avoid",
  "version": "0.1.1",
  "description": "Request video and channel recommendation feedback for a Short with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/youtube.js", "src/workflow.js", "src/content.js"],
      "css": ["control.css"],
      "run_at": "document_idle"
    }
  ]
}
