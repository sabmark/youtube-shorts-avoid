{
  "manifest_version": 3,
  "name": "Shorts Avoid for YouTube",
  "version": "0.1.24",
  "description": "Avoid or Like desktop Shorts and move on, using buttons or custom keyboard and mouse shortcuts.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/youtube.js",
        "src/workflow.js",
        "src/shortcut.js",
        "src/content.js"
      ],
      "css": [
        "control.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Shorts Avoid for YouTube",
    "default_popup": "popup.html"
  }
}
